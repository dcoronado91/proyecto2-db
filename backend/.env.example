# Base de datos
DATABASE_URL=postgres://proy3:secret@localhost:5432/tienda

# ─────────────────────────────────────────────
# JWT_SECRET — llave privada para firmar tokens
#
# IMPORTANTE: un secret débil permite que cualquier
# atacante genere tokens falsos con rol admin.
#
# Generar uno seguro (512 bits):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Reglas:
#   - Mínimo 32 caracteres (el servidor rechaza menos)
#   - Nunca usar palabras o frases legibles
#   - Nunca commitear el valor real a git
#   - Rotar cada 90 días en producción (invalida todos los tokens activos)
# ─────────────────────────────────────────────
JWT_SECRET=reemplazar_con_valor_generado_por_crypto_randomBytes_64

# Puerto del servidor
PORT=4000

# CORS — URL del frontend (sin slash al final)
# Desarrollo local:
FRONTEND_URL=http://localhost:5173
# Producción (separar múltiples orígenes con coma):
# FRONTEND_URL=https://tu-frontend.netlify.app
